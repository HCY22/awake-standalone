#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_AWAKE      ICON "awake.ico"
IDI_TIMED      ICON "timed.ico"
IDI_EXPIRABLE  ICON "expirable.ico"
IDI_INDEFINITE ICON "indefinite.ico"
IDI_DISABLED   ICON "disabled.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "awake.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AWAKE_VERSION_MAJOR,AWAKE_VERSION_MINOR,AWAKE_VERSION_PATCH,0
 PRODUCTVERSION AWAKE_VERSION_MAJOR,AWAKE_VERSION_MINOR,AWAKE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Awake - keep your PC awake"
            VALUE "FileVersion", AWAKE_VERSION_STRING
            VALUE "InternalName", "Awake"
            VALUE "LegalCopyright", "MIT License. Based on Microsoft PowerToys Awake."
            VALUE "OriginalFilename", "Awake.exe"
            VALUE "ProductName", "Awake (standalone)"
            VALUE "ProductVersion", AWAKE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
